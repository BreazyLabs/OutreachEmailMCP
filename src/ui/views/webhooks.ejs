<%- include('_header') %>
<div class="pagehead">
  <div>
    <h1>Webhooks</h1>
    <p class="sub">Registered URLs receive a signed POST (<code>X-EmailProxy-Signature: sha256=HMAC(secret, body)</code>) for every new inbound message.</p>
  </div>
</div>
<div class="card">
  <div class="card-head"><h3>New webhook</h3></div>
  <form method="post" action="/ui/webhooks" class="row">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input name="url" placeholder="https://example.com/hooks/email" style="flex:2; min-width:240px" aria-label="URL">
    <select name="accountId" aria-label="Mailbox">
      <option value="">All mailboxes</option>
      <% for (const a of accounts) { %><option value="<%= a.id %>"><%= a.email %></option><% } %>
    </select>
    <button type="submit">Add webhook</button>
  </form>
</div>
<div class="card flush">
  <div class="card-head"><h3>Endpoints</h3></div>
  <% if (hooks.length === 0) { %><p class="empty">No webhooks yet.</p><% } else { %>
  <div class="scroll-x">
  <table>
    <thead><tr><th>URL</th><th>Scope</th><th>Secret</th><th></th></tr></thead>
    <tbody>
    <% for (const w of hooks) { %>
    <tr>
      <td class="mono"><%= w.url %></td>
      <td class="muted"><%= w.accountId ? (accounts.find(a => a.id === w.accountId)?.email ?? w.accountId) : 'all mailboxes' %></td>
      <td><code class="reveal" title="hover to reveal"><%= w.secret %></code></td>
      <td style="text-align:right">
        <form class="inline" method="post" action="/ui/webhooks/<%= w.id %>/delete">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="danger" type="submit">Delete</button>
        </form>
      </td>
    </tr>
    <% } %>
    </tbody>
  </table>
  </div>
  <% } %>
</div>
<div class="card flush">
  <div class="card-head"><h3>Recent deliveries</h3></div>
  <% if (deliveries.length === 0) { %><p class="empty">No deliveries yet.</p><% } else { %>
  <div class="scroll-x">
  <table>
    <thead><tr><th>When</th><th>Event</th><th>Status</th><th class="num">Attempts</th><th class="num">Response</th><th>Error</th></tr></thead>
    <tbody>
    <% for (const d of deliveries) { %>
    <tr>
      <td class="muted" style="white-space:nowrap"><%= new Date(d.createdAt).toLocaleString() %></td>
      <td><%= d.event %></td>
      <td><span class="badge <%= d.status %>"><%= d.status %></span></td>
      <td class="num muted"><%= d.attempts %></td>
      <td class="num muted"><%= d.responseStatus ?? '—' %></td>
      <td class="muted"><%= d.lastError || '' %></td>
    </tr>
    <% } %>
    </tbody>
  </table>
  </div>
  <% } %>
</div>
<%- include('_footer') %>
