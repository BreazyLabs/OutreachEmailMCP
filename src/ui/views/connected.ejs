<%- include('_header') %>
<div class="card" style="max-width:440px; margin:15vh auto; text-align:center;">
  <% if (error) { %>
    <h1>Connection failed</h1>
    <p class="muted">The account could not be connected. You can close this window and try the link again.</p>
  <% } else { %>
    <h1>✅ Account connected</h1>
    <p><strong><%= email %></strong> is now connected to OutreachEmailMCP.</p>
    <p class="muted">You can close this window.</p>
  <% } %>
</div>
<%- include('_footer') %>
