<%- include('_header') %>
<%
  const fmtDate = (t) => t ? new Date(t).toLocaleDateString() : '—';
  const fmtWhen = (t) => t ? new Date(t).toLocaleString() : '—';
  const nc = integrations.namecheap; const pi = integrations.premiuminboxes;
  const shown = showAll ? domains : domains.filter((d) => d.platform);
  const hidden = domains.length - shown.length;
  const counts = { purchased: 0, ordered: 0, provisioned: 0, connected: 0 };
  for (const d of shown) counts[d.status] = (counts[d.status] || 0) + 1;
  const deliveredTotal = orders.reduce((n, o) => n + o.delivered, 0);
  const connectedTotal = orders.reduce((n, o) => n + o.connected, 0);
  const idle = domains.filter((d) => d.status === 'purchased');
  const autoRenewOn = domains.filter((d) => d.platform && d.registrar === 'namecheap' && d.registrarInfo.autoRenew);
  const stepClass = (s) => ({ purchased: 'paused', ordered: 'ramping', provisioned: 'queued', connected: 'active' })[s] || '';
  const w = wizard;
  const picked = new Set(w.picked);
%>
<style>
  .pagehead { display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; margin-bottom:0.2rem; }
  .pagehead h1 { margin:0.4rem 0; }
  .pagehead .row { gap:0.4rem; }
  .btn.ghost, button.ghost { background:transparent; color:var(--fg); border:1px solid var(--line); }
  .btn.ghost:hover, button.ghost:hover { border-color:var(--accent); color:var(--accent); }
  .kpis { display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:0.7rem; margin-top:0.8rem; }
  .kpi { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:0.65rem 0.85rem; }
  .kpi .n { font-size:1.35rem; font-weight:700; font-variant-numeric:tabular-nums; line-height:1.15; }
  .kpi .n small { font-size:0.8rem; color:var(--muted); font-weight:500; }
  .kpi .l { color:var(--muted); font-size:0.74rem; text-transform:uppercase; letter-spacing:0.04em; margin-top:0.15rem; }
  .kpi.bad .n { color:var(--err); } .kpi.good .n { color:var(--ok); } .kpi.warn .n { color:var(--warn); }
  .badge.ramping { background:color-mix(in srgb, var(--warn) 15%, transparent); color:var(--warn); }
  .badge.paused { background:color-mix(in srgb, var(--muted) 15%, transparent); color:var(--muted); }
  .health { display:inline-flex; align-items:center; gap:0.35rem; font-weight:600; font-size:0.8rem; white-space:nowrap; }
  .health .dot { width:9px; height:9px; border-radius:50%; display:inline-block; }
  .health.healthy { color:var(--ok); } .health.healthy .dot { background:var(--ok); }
  .health.watch { color:var(--warn); } .health.watch .dot { background:var(--warn); }
  .health.at_risk { color:var(--err); } .health.at_risk .dot { background:var(--err); }
  .health.no_data { color:var(--muted); } .health.no_data .dot { background:var(--muted); }
  .num { font-variant-numeric:tabular-nums; text-align:right; white-space:nowrap; }
  .tag { display:inline-block; padding:0 0.45rem; border-radius:99px; font-size:0.7rem; background:color-mix(in srgb, var(--accent) 12%, transparent); color:var(--accent); margin-left:0.2rem; vertical-align:1px; }
  .status { display:flex; gap:0.5rem; align-items:center; font-size:0.85rem; }
  .status .dot { width:9px; height:9px; border-radius:50%; background:var(--muted); }
  .status.ok .dot { background:var(--ok); } .status.bad .dot { background:var(--err); }
  .steps { display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap; font-size:0.8rem; color:var(--muted); margin:0.6rem 0 0.2rem; }
  .steps b { color:var(--fg); }
  .steps .arrow { opacity:0.5; }
  dialog { border:1px solid var(--line); border-radius:12px; padding:0; background:var(--card); color:var(--fg); box-shadow:0 20px 60px rgba(0,0,0,0.25); }
  dialog::backdrop { background:rgba(10,10,20,0.45); }
  dialog.modal { width:min(760px, calc(100vw - 2rem)); max-height:calc(100vh - 3rem); overflow:hidden; }
  dialog.slide { position:fixed; inset:0 0 0 auto; margin:0; height:100vh; max-height:100vh; width:min(820px, 100vw); border-radius:0; border-width:0 0 0 1px; transform:translateX(100%); transition:transform 0.22s ease; }
  dialog.slide[open] { transform:none; }
  @media (prefers-reduced-motion: reduce) { dialog.slide { transition:none; } }
  .dlg { display:flex; flex-direction:column; }
  dialog.modal .dlg { max-height:calc(100vh - 3rem); }
  dialog.slide .dlg { height:100vh; }
  .dlg header { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; padding:1rem 1.2rem 0.7rem; border-bottom:1px solid var(--line); }
  .dlg header h2 { margin:0; font-size:1.05rem; }
  .dlg header .who { color:var(--muted); font-size:0.8rem; margin-top:0.25rem; max-width:70ch; }
  .dlg .body { padding:1rem 1.2rem; overflow:auto; flex:1 1 auto; min-height:0; }
  .dlg footer { display:flex; gap:0.5rem; align-items:center; justify-content:flex-end; padding:0.7rem 1.2rem; border-top:1px solid var(--line); flex-wrap:wrap; }
  .dlg footer .left { margin-right:auto; color:var(--muted); font-size:0.8rem; }
  .x { background:transparent; border:none; color:var(--muted); font-size:1.3rem; line-height:1; cursor:pointer; padding:0.1rem 0.3rem; }
  .field { display:grid; gap:0.25rem; margin-bottom:0.7rem; }
  .field label { font-size:0.78rem; color:var(--muted); }
  .field input, .field select, .field textarea { width:100%; }
  .grid2 { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:0 1rem; }
  .grid3 { display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:0 1rem; }
  .note { border-radius:8px; padding:0.6rem 0.8rem; font-size:0.85rem; margin:0 0 0.8rem; background:color-mix(in srgb, var(--warn) 12%, transparent); color:var(--warn); }
  .note.ok { background:color-mix(in srgb, var(--ok) 12%, transparent); color:var(--ok); }
  .note.bad { background:color-mix(in srgb, var(--err) 12%, transparent); color:var(--err); }
  .note.info { background:color-mix(in srgb, var(--accent) 10%, transparent); color:var(--fg); }
  .tldpick { display:flex; gap:0.4rem; flex-wrap:wrap; }
  .tldpick label { border:1px solid var(--line); border-radius:99px; padding:0.15rem 0.6rem; font-size:0.82rem; cursor:pointer; }
  .tldpick label:has(input:checked) { border-color:var(--accent); background:color-mix(in srgb, var(--accent) 12%, transparent); color:var(--accent); }
  .tldpick input { display:none; }
  tr.dim td { opacity:0.5; }
  .reveal { filter: blur(4px); transition: filter 0.15s; } .reveal:hover { filter:none; }
  h3.sect { font-size:0.9rem; margin:1.1rem 0 0.4rem; text-transform:uppercase; letter-spacing:0.04em; color:var(--muted); }
  .empty { color:var(--muted); font-size:0.88rem; padding:0.6rem 0; }
  .wiz h3 { font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--muted); margin:1.2rem 0 0.5rem; display:flex; align-items:center; gap:0.5rem; }
  .wiz h3 .n { display:inline-flex; width:20px; height:20px; border-radius:50%; background:var(--accent); color:#fff; font-size:0.72rem; align-items:center; justify-content:center; }
  .patterns { display:flex; gap:0.4rem; flex-wrap:wrap; }
  .patterns label { border:1px solid var(--line); border-radius:8px; padding:0.3rem 0.6rem; font-size:0.82rem; cursor:pointer; display:grid; }
  .patterns label small { color:var(--muted); font-family: ui-monospace, monospace; font-size:0.72rem; }
  .patterns label:has(input:checked) { border-color:var(--accent); background:color-mix(in srgb, var(--accent) 12%, transparent); }
  .patterns input { display:none; }
  .pic { display:flex; gap:0.8rem; align-items:center; }
  .pic img { width:56px; height:56px; border-radius:50%; object-fit:cover; border:1px solid var(--line); background:var(--bg); }
  .cost td, .cost th { padding:0.35rem 0.5rem; }
  .cost tfoot td { font-weight:700; border-top:2px solid var(--line); }
  .picklist { display:grid; grid-template-columns:repeat(auto-fill, minmax(230px, 1fr)); gap:0.15rem 1rem; font-size:0.85rem; }
  .bigbtn { padding:0.7rem 1.2rem; font-size:0.95rem; }
</style>

<div class="pagehead">
  <h1>Domains</h1>
  <div class="row">
    <button type="button" data-open="dlg-batch" <%= nc.configured || pi.configured ? '' : 'disabled title="Connect Namecheap and Premium Inboxes first"' %>>+ New batch</button>
    <% if (pi.configured) { %><form method="post" action="/ui/domains/orders/sync" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" class="ghost">Check orders now</button></form><% } %>
    <button type="button" class="ghost" data-open="dlg-integrations">Integrations</button>
  </div>
</div>
<p class="muted" style="max-width:80ch; margin:0.2rem 0 0.4rem">A batch goes from brand word to warmed mailboxes in one click: pick or paste domains, set up the person and the addresses, see what it costs, and the proxy buys the domains at Namecheap and orders the mailboxes at Premium Inboxes. Orders are checked every 10 minutes.</p>
<div class="steps">
  <span class="status <%= nc.configured ? (nc.lastError ? 'bad' : 'ok') : '' %>"><span class="dot"></span>Namecheap <%= nc.configured ? (nc.lastError ? 'error' : 'connected') : 'not connected' %></span>
  <span class="arrow">·</span>
  <span class="status <%= pi.configured ? (pi.lastError ? 'bad' : 'ok') : '' %>"><span class="dot"></span>Premium Inboxes <%= pi.configured ? (pi.lastError ? 'error' : 'connected') : 'not connected' %></span>
  <% if (nc.lastError || pi.lastError) { %><span class="arrow">·</span><span style="color:var(--err)"><%= (nc.lastError || pi.lastError).slice(0, 120) %></span><% } %>
</div>

<div class="kpis">
  <div class="kpi"><div class="n"><%= shown.length %></div><div class="l">domains<%= showAll ? '' : ' bought here' %></div><div class="muted" style="font-size:0.75rem"><%= counts.purchased %> idle · <%= counts.ordered %> ordered · <%= counts.provisioned %> provisioned · <%= counts.connected %> connected</div></div>
  <div class="kpi"><div class="n"><%= orders.length %></div><div class="l">orders</div><div class="muted" style="font-size:0.75rem"><%= orders.filter((o) => o.delivered === 0).length %> in progress</div></div>
  <div class="kpi <%= deliveredTotal && connectedTotal < deliveredTotal ? 'warn' : deliveredTotal ? 'good' : '' %>"><div class="n"><%= connectedTotal %><small>/<%= deliveredTotal %></small></div><div class="l">mailboxes connected</div><div class="muted" style="font-size:0.75rem">of those delivered by orders</div></div>
  <div class="kpi"><div class="n"><%= (pricePerInboxCents / 100).toFixed(2) %><small> / inbox</small></div><div class="l">per 4 weeks</div><div class="muted" style="font-size:0.75rem">learned from your subscriptions</div></div>
</div>

<% if (autoRenewOn.length) { %>
<div class="alert error" style="margin-top:0.8rem"><b><%= autoRenewOn.length %> domain<%= autoRenewOn.length === 1 ? ' bought here has' : 's bought here have' %> auto-renew on at Namecheap:</b> <%= autoRenewOn.slice(0, 8).map((d) => d.domain).join(', ') %><%= autoRenewOn.length > 8 ? ` and ${autoRenewOn.length - 8} more` : '' %>. Namecheap's API cannot switch it off, so do it once in the <a href="https://ap.www.namecheap.com/domains/list/" target="_blank" rel="noopener">Namecheap domain list</a> (tick the domains, Auto-Renew, Off); the flag here refreshes daily and after every purchase.</div>
<% } %>
<h2 style="display:flex; justify-content:space-between; align-items:baseline">Domains <span class="muted" style="font-weight:400; font-size:0.82rem"><% if (showAll) { %><a href="/ui/domains">Show only domains bought here</a><% } else if (hidden) { %><a href="/ui/domains?all=1">Show all <%= domains.length %>, including <%= hidden %> imported</a><% } %></span></h2>
<div class="card">
  <% if (shown.length === 0) { %>
    <p class="empty">Nothing bought through the platform yet. Start a <b>New batch</b><%= hidden ? `, or <a href="/ui/domains?all=1">show the ${hidden} imported domains</a>` : '' %>.</p>
  <% } else { %>
  <div style="overflow-x:auto">
  <table>
    <thead><tr><th>Domain</th><th>Step</th><th>Bought</th><th>Expires</th><th title="Namecheap's auto-renew flag, refreshed daily">Renew</th><th title="SPF, DKIM, DMARC of the domain">DNS</th><th class="num">Mailboxes</th><th>Order</th></tr></thead>
    <tbody>
    <% for (const d of shown) { %>
    <tr class="<%= d.status === 'connected' ? 'dim' : '' %>">
      <td><b><%= d.domain %></b><% for (const tg of d.tags) { %><span class="tag"><%= tg %></span><% } %><% if (!d.platform) { %><span class="muted" style="font-size:0.75rem"> · imported</span><% } %></td>
      <td><span class="badge <%= stepClass(d.status) %>"><%= d.status === 'purchased' ? 'idle' : d.status %></span></td>
      <td class="muted"><%= d.purchasedAt ? fmtDate(d.purchasedAt) : (d.registrar === 'namecheap' ? 'Namecheap' : '—') %></td>
      <td class="muted"><%= fmtDate(d.expiresAt) %></td>
      <td><% if (d.registrar === 'namecheap' && d.registrarInfo.autoRenew !== undefined) { %><span class="badge <%= d.registrarInfo.autoRenew ? 'failed' : 'paused' %>" title="Auto-renew at Namecheap"><%= d.registrarInfo.autoRenew ? 'auto' : 'manual' %></span><% } else { %><span class="muted">—</span><% } %></td>
      <td><% const dv = d.dns.verdict; %><span class="health <%= dv === 'ok' ? 'healthy' : dv === 'warn' ? 'watch' : dv === 'bad' ? 'at_risk' : 'no_data' %>" title="<%= d.dns.issues.length ? d.dns.issues.join(' · ') : dv === 'unchecked' ? 'Checked once a mailbox on it is connected' : 'SPF, DKIM, DMARC present' %>"><span class="dot"></span><%= dv === 'unchecked' ? '…' : dv %></span></td>
      <td class="num"><%= d.mailboxes.connected %><span class="muted">/<%= Math.max(d.mailboxes.delivered, d.mailboxes.connected) %></span></td>
      <td class="muted"><% if (d.order) { %><button type="button" class="ghost" style="padding:0.15rem 0.5rem; font-size:0.75rem" data-open="dlg-order-<%= d.order.id %>"><%= d.order.status %></button><% } else { %>—<% } %></td>
    </tr>
    <% } %>
    </tbody>
  </table>
  </div>
  <% } %>
</div>

<h2>Orders</h2>
<div class="card">
  <% if (orders.length === 0) { %>
    <p class="empty">No orders yet<%= pi.configured ? '' : '. Connect Premium Inboxes under Integrations to place one' %>.</p>
  <% } else { %>
  <table>
    <thead><tr><th>Placed</th><th>Order</th><th>Status</th><th>Provider</th><th>Domains</th><th class="num">Mailboxes</th><th>Issues</th><th></th></tr></thead>
    <tbody>
    <% for (const o of orders) { const r = o.result; %>
    <tr>
      <td class="muted"><%= fmtDate(o.order.createdAt) %></td>
      <td class="mono" style="font-size:0.78rem"><%= o.order.externalId || o.order.id %></td>
      <td><span class="badge <%= o.delivered ? (o.connected === o.delivered ? 'active' : 'queued') : 'ramping' %>"><%= o.order.status %></span></td>
      <td class="muted"><%= o.order.emailProvider %></td>
      <td class="muted" style="max-width:34ch"><%= o.domains.join(', ') %></td>
      <td class="num"><%= o.connected %><span class="muted">/<%= o.delivered || (r ? r.inboxes.total : '?') %></span></td>
      <td class="muted" style="max-width:30ch"><%= r && r.issues.length ? r.issues.map((i) => i.reason).join(' · ') : '' %></td>
      <td><button type="button" class="ghost" style="padding:0.2rem 0.6rem; font-size:0.78rem" data-open="dlg-order-<%= o.order.id %>">Mailboxes</button></td>
    </tr>
    <% } %>
    </tbody>
  </table>
  <p class="muted" style="margin:0.5rem 0 0">Last checked: <%= fmtWhen(Math.max(0, ...orders.map((o) => o.order.lastCheckedAt || 0))) %></p>
  <% } %>
</div>

<%# ---- the batch wizard: one form, three steps, one click at the end ---- %>
<dialog class="slide" id="dlg-batch" style="width:min(900px, 100vw)">
  <form method="post" action="/ui/domains/batch" class="dlg wiz" id="batch">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="pictureData" id="pictureData">
    <header><div><h2>New batch</h2><div class="who">Domains are registered at Namecheap for one year with WhoisGuard; mailboxes are ordered at Premium Inboxes and billed by them per 4 weeks.</div></div><button type="button" class="x" data-close aria-label="Close">×</button></header>
    <div class="body">
      <% if (wizardError) { %><div class="note bad" id="wizard-error"><b>That did not go through.</b> <%= wizardError %> Everything you entered is still here; fix it and try again.</div><% } %>
      <% if (!nc.configured) { %><div class="note bad">Namecheap is not connected: you can only order on domains already bought. Open Integrations to connect it.</div><% } %>
      <% if (!pi.configured) { %><div class="note bad">Premium Inboxes is not connected: domains can be bought but no mailboxes ordered. Open Integrations to connect it.</div><% } %>

      <h3><span class="n">1</span> Domains</h3>
      <div class="grid2">
        <div class="field"><label>Brand word, suggestions are built around it</label><input name="brand" value="<%= w.brand %>" placeholder="breazy" autocomplete="off"></div>
        <div class="field"><label>Or paste domains to check, comma separated</label><input name="custom" value="<%= w.custom.replace(/\n/g, ', ') %>" placeholder="getbreazy.nl, trybreazy.com, breazygrowth.nl"></div>
      </div>
      <div class="row" style="justify-content:space-between; align-items:flex-end">
        <div class="field" style="margin:0"><label>Endings for suggestions</label>
          <div class="tldpick"><% for (const t of ['com', 'nl', 'co', 'io', 'net', 'org', 'eu', 'de', 'be', 'agency']) { %><label><input type="checkbox" name="tlds" value="<%= t %>" <%= w.tlds.includes(t) ? 'checked' : '' %>>.<%= t %></label><% } %></div>
        </div>
        <button type="submit" formaction="/ui/domains/find" formnovalidate class="secondary" <%= nc.configured ? '' : 'disabled' %>>Check availability</button>
      </div>
      <% if (candidates) { %>
      <% const avail = candidates.filter((c) => c.available && !c.owned); %>
      <div class="row" style="justify-content:space-between; margin-top:0.6rem">
        <b><%= avail.length %> of <%= candidates.length %> available</b>
        <button type="button" class="secondary" style="padding:0.25rem 0.6rem; font-size:0.78rem" id="tick-all">Tick all available</button>
      </div>
      <table style="margin-top:0.3rem">
        <thead><tr><th></th><th>Domain</th><th>Status</th><th class="num">Price / year</th></tr></thead>
        <tbody>
        <% for (const c of candidates) { %>
        <tr class="<%= c.available && !c.owned ? '' : 'dim' %>">
          <td><% if (c.available && !c.owned) { %><input type="checkbox" name="domains" value="<%= c.domain %>" class="pick" data-price="<%= c.price || 0 %>" data-tld="<%= c.tld %>" <%= picked.has(c.domain) ? 'checked' : '' %>><% } %></td>
          <td><%= c.domain %></td>
          <td class="muted"><%= c.owned ? 'yours' : c.available === null ? 'unknown' : c.available ? (c.premium ? 'available · premium' : 'available') : 'taken' %></td>
          <td class="num"><%= c.price !== null ? c.price.toFixed(2) + ' ' + (c.currency || '') : '—' %></td>
        </tr>
        <% } %>
        </tbody>
      </table>
      <% } %>
      <% const known = new Set([...(candidates || []).map((c) => c.domain), ...idle.map((d) => d.domain)]); const unchecked = w.picked.filter((d) => !known.has(d)); %>
      <% if (unchecked.length) { %>
      <p class="muted" style="margin:0.8rem 0 0.3rem">Ticked but not checked yet, press <b>Check availability</b> for prices:</p>
      <div class="picklist"><% for (const d of unchecked) { %><label><input type="checkbox" name="domains" value="<%= d %>" class="pick" data-price="0" checked> <%= d %></label><% } %></div>
      <% } %>
      <% if (idle.length) { %>
      <p class="muted" style="margin:0.8rem 0 0.3rem">Domains you already own with no mailboxes yet, free to add to this batch:</p>
      <div class="picklist"><% for (const d of idle) { %><label><input type="checkbox" name="domains" value="<%= d.domain %>" class="pick" data-price="0" data-owned="1" <%= picked.has(d.domain) ? 'checked' : '' %>> <%= d.domain %></label><% } %></div>
      <% } %>

      <h3><span class="n">2</span> Mailboxes</h3>
      <div class="grid3">
        <div class="field"><label>Provider</label><select name="emailProvider"><option value="google" <%= w.emailProvider === 'google' ? 'selected' : '' %>>Google Workspace</option><option value="microsoft" <%= w.emailProvider === 'microsoft' ? 'selected' : '' %>>Microsoft 365</option></select></div>
        <div class="field"><label>Forwarding domain, where the new domains redirect to</label><input name="forwardedDomain" value="<%= w.forwardedDomain %>" placeholder="kandidaatflow.nl" required></div>
        <div class="field"><label>Inboxes per domain</label><input type="number" name="inboxesPerDomain" id="perDomain" min="1" max="10" value="<%= w.inboxesPerDomain %>"></div>
        <div class="field"><label>Mailbox password</label><input name="password" value="<%= w.password || suggestedPassword %>"></div>
        <div class="field"><label>First name</label><input name="firstName" id="firstName" value="<%= w.firstName %>" placeholder="Dave" autocomplete="off"></div>
        <div class="field"><label>Last name</label><input name="lastName" id="lastName" value="<%= w.lastName %>" placeholder="Spies" autocomplete="off"></div>
        <div class="field"><label>Tag the batch</label><input name="tags" value="<%= w.tags %>" placeholder="batch-4, client-x"></div>
      </div>
      <div class="field"><label>Addresses, tick as many patterns as inboxes per domain</label>
        <div class="patterns" id="patterns">
          <% for (const p of patterns) { %><label><input type="checkbox" name="patterns" value="<%= p.key %>" <%= w.patterns.includes(p.key) ? 'checked' : '' %>><span><%= p.label %></span><small data-pattern="<%= p.key %>"><%= p.example %></small></label><% } %>
        </div>
      </div>
      <div class="grid2">
        <div class="field"><label>Profile picture</label>
          <div class="pic"><img id="picPreview" src="<%= w.pictureUrl %>" alt="" <%= w.pictureUrl ? '' : 'hidden' %>><div style="flex:1"><input type="file" id="picFile" accept="image/png,image/jpeg,image/webp"><input name="pictureUrl" id="pictureUrl" value="<%= w.pictureUrl %>" placeholder="or a public image URL" style="margin-top:0.3rem"></div></div>
        </div>
        <div class="field"><label>Extra instructions for Premium Inboxes</label><textarea name="additionalInfo" rows="3" placeholder="Anything they should know"><%= w.additionalInfo %></textarea>
          <label style="font-size:0.85rem"><input type="checkbox" name="insured" value="1" <%= w.insured ? 'checked' : '' %>> Insured order</label></div>
      </div>

      <h3><span class="n">3</span> Cost</h3>
      <table class="cost" id="cost">
        <thead><tr><th>Item</th><th class="num">Qty</th><th class="num">Unit</th><th class="num">Amount</th></tr></thead>
        <tbody id="cost-body"><tr><td class="muted" colspan="4">Tick domains above to see the breakdown.</td></tr></tbody>
        <tfoot id="cost-foot"></tfoot>
      </table>
      <% if (balance) { %><div class="note <%= balance.available > 0 ? 'info' : 'bad' %>" id="balance-note" data-available="<%= balance.available %>" style="margin-top:0.6rem">Namecheap balance: <b><%= balance.available.toFixed(2) %> <%= balance.currency %></b>. Namecheap bills API registrations from this balance only, never from a card; <a href="https://www.namecheap.com/support/knowledgebase/article.aspx/9739/2200/how-to-add-funds-to-your-namecheap-account/" target="_blank" rel="noopener">add funds</a> before a batch that needs more. <span id="balance-verdict"></span></div><% } %>
      <p class="mini" style="margin:0.4rem 0 0">Domain prices are Namecheap's first-year price per ending (<%= candidates && candidates.length ? 'as checked above' : 'shown after a check' %>). Mailboxes are <%= (pricePerInboxCents / 100).toFixed(2) %> each per 4 weeks, the rate on your current subscriptions; Premium Inboxes bills them, not this platform.</p>
    </div>
    <footer>
      <span class="left" id="batch-summary"></span>
      <button type="button" class="secondary" id="batch-export" title="Download this batch as JSON">Export JSON</button>
      <button type="button" class="secondary" id="batch-import-btn" title="Load a batch from JSON">Import JSON</button>
      <input type="file" id="batch-import" accept="application/json,.json" hidden>
      <button type="button" class="secondary" id="batch-clear" title="Forget the autosaved draft and start empty">Clear</button>
      <button type="button" class="secondary" data-close>Close</button>
      <button type="submit" class="bigbtn" id="batch-submit" <%= pi.configured ? '' : 'disabled title="Connect Premium Inboxes first"' %>>Buy &amp; order</button>
    </footer>
  </form>
</dialog>

<%# ---- order detail modals ---- %>
<% for (const o of orders) { const r = o.result; const emails = orderMailboxesById[o.order.id] || []; %>
<dialog class="modal" id="dlg-order-<%= o.order.id %>">
  <div class="dlg">
    <header><div><h2>Order <%= o.order.externalId || o.order.id %></h2><div class="who"><%= o.order.status %> · <%= o.order.emailProvider %> · <%= o.domains.join(', ') %><% if (r && r.workspaceName) { %> · workspace <%= r.workspaceName %><% } %></div></div><button type="button" class="x" data-close aria-label="Close">×</button></header>
    <div class="body">
      <% if (r && r.issues.length) { %><div class="note bad"><b>Issues reported:</b> <%= r.issues.map((i) => i.reason).join(' · ') %></div><% } %>
      <% if (emails.length === 0) { %>
        <p class="empty">No mailboxes delivered yet<%= r ? ` (${r.inboxes.total} expected)` : '' %>. Checked every 10 minutes; use <b>Check orders now</b> to look sooner.</p>
      <% } else { %>
        <% const todo = emails.filter((e) => !e.connected); %>
        <div class="note <%= todo.length ? '' : 'ok' %>"><%= emails.length - todo.length %> of <%= emails.length %> mailboxes connected to this gateway.<% if (todo.length) { %> The rest need one OAuth consent each: open the onboarding link signed in as the mailbox (address and password below), or hand this list to Premium Inboxes.<% } %></div>
        <div class="row" style="margin:0 0 0.6rem"><input class="mono" readonly value="<%= hubLink %>" onclick="this.select()" style="flex:1"><a class="btn secondary" style="color:inherit" href="<%= hubLink %>" target="_blank" rel="noopener">Open</a></div>
        <table>
          <thead><tr><th>Mailbox</th><th>Name</th><th>Password</th><th>Status</th></tr></thead>
          <tbody>
          <% for (const e of emails) { %>
          <tr><td><%= e.email %></td><td class="muted"><%= [e.firstName, e.lastName].filter(Boolean).join(' ') %></td><td><code class="reveal" title="hover to reveal"><%= e.password %></code></td><td><% if (e.connected) { %><span class="badge active">connected</span><% } else { %><span class="badge queued"><%= e.status || 'delivered' %></span><% } %></td></tr>
          <% } %>
          </tbody>
        </table>
        <% if (todo.length) { %>
        <details style="margin-top:0.7rem"><summary class="muted" style="cursor:pointer">Checklist to hand over</summary>
          <textarea readonly rows="6" style="width:100%; margin-top:0.4rem" onclick="this.select()">Connect these mailboxes at <%= hubLink %> (sign in as the mailbox, accept access):
<% for (const e of todo) { %><%= e.email %> / <%= e.password %>
<% } %></textarea>
        </details>
        <% } %>
      <% } %>
    </div>
    <footer><span class="left">Placed <%= fmtWhen(o.order.createdAt) %> · last checked <%= fmtWhen(o.order.lastCheckedAt) %></span><button type="button" class="secondary" data-close>Close</button></footer>
  </div>
</dialog>
<% } %>

<%# ---- integrations slide-over ---- %>
<dialog class="slide" id="dlg-integrations">
  <div class="dlg">
    <header><div><h2>Integrations</h2><div class="who">Credentials are stored encrypted with the instance master key and only ever used server-side.</div></div><button type="button" class="x" data-close aria-label="Close">×</button></header>
    <div class="body">
      <h3 class="sect">Namecheap <span class="status <%= nc.configured ? (nc.lastError ? 'bad' : 'ok') : '' %>" style="display:inline-flex; margin-left:0.5rem; text-transform:none; letter-spacing:0"><span class="dot"></span><%= nc.configured ? (nc.verifiedAt ? 'verified ' + fmtWhen(nc.verifiedAt) : 'saved, not verified') : 'not connected' %></span></h3>
      <% if (nc.lastError) { %><div class="note bad"><%= nc.lastError %></div><% } %>
      <form method="post" action="/ui/integrations/namecheap">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <p class="muted" style="margin:0 0 0.6rem">Enable API access in the Namecheap profile (Tools → API access), whitelist this server's public IP, and paste the key. Registration needs a registrant contact: leave the contact blank and the account's default address is copied in on save, the way the Namecheap site does it. The same contact is used for every role, with WhoisGuard on.</p>
        <div class="grid3">
          <div class="field"><label>API user</label><input name="apiUser" value="<%= nc.apiUser %>" required></div>
          <div class="field"><label>API key <%= nc.configured ? '(leave blank to keep ' + nc.apiKeyMasked + ')' : '' %></label><input name="apiKey" placeholder="<%= nc.configured ? nc.apiKeyMasked : '' %>" autocomplete="off"></div>
          <div class="field"><label>Whitelisted client IP</label><input name="clientIp" value="<%= nc.clientIp %>" placeholder="this server's public IPv4" required></div>
        </div>
        <div class="grid3">
          <div class="field"><label>Username (if different)</label><input name="username" value="<%= nc.username %>"></div>
          <div class="field"><label style="margin-top:1.2rem"><input type="checkbox" name="sandbox" value="1" <%= nc.sandbox ? 'checked' : '' %>> Use the sandbox API</label></div>
        </div>
        <% const c = nc.contact || {}; %>
        <div class="grid3">
          <div class="field"><label>First name</label><input name="c_firstName" value="<%= c.firstName || '' %>"></div>
          <div class="field"><label>Last name</label><input name="c_lastName" value="<%= c.lastName || '' %>"></div>
          <div class="field"><label>Organization</label><input name="c_organization" value="<%= c.organization || '' %>"></div>
          <div class="field"><label>Address</label><input name="c_address1" value="<%= c.address1 || '' %>"></div>
          <div class="field"><label>City</label><input name="c_city" value="<%= c.city || '' %>"></div>
          <div class="field"><label>State / province</label><input name="c_stateProvince" value="<%= c.stateProvince || '' %>" placeholder="NH"></div>
          <div class="field"><label>Postal code</label><input name="c_postalCode" value="<%= c.postalCode || '' %>"></div>
          <div class="field"><label>Country (2 letters)</label><input name="c_country" value="<%= c.country || 'NL' %>" maxlength="2"></div>
          <div class="field"><label>Phone (+CC.number)</label><input name="c_phone" value="<%= c.phone || '' %>" placeholder="+31.612345678"></div>
          <div class="field"><label>Email</label><input name="c_email" value="<%= c.email || '' %>"></div>
        </div>
        <div class="row">
          <button type="submit">Save &amp; test</button>
          <% if (nc.configured) { %><button type="submit" name="delete" value="1" class="secondary" data-confirm="Disconnect Namecheap from this workspace?">Disconnect</button><% } %>
        </div>
      </form>

      <h3 class="sect" style="margin-top:1.6rem">Premium Inboxes <span class="status <%= pi.configured ? (pi.lastError ? 'bad' : 'ok') : '' %>" style="display:inline-flex; margin-left:0.5rem; text-transform:none; letter-spacing:0"><span class="dot"></span><%= pi.configured ? (pi.verifiedAt ? 'verified ' + fmtWhen(pi.verifiedAt) : 'saved, not verified') : 'not connected' %></span></h3>
      <% if (pi.lastError) { %><div class="note bad"><%= pi.lastError %></div><% } %>
      <form method="post" action="/ui/integrations/premiuminboxes">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <p class="muted" style="margin:0 0 0.6rem">Generate the token in the Premium Inboxes portal under Settings → API Token. The hosting login is what their team uses to set the domains' DNS. Leave it blank when they already have your access on file; the order then says so.</p>
        <div class="grid2">
          <div class="field"><label>API token <%= pi.configured ? '(leave blank to keep ' + pi.tokenMasked + ')' : '' %></label><input name="apiToken" placeholder="<%= pi.configured ? pi.tokenMasked : '' %>" autocomplete="off"></div>
          <div class="field"><label>Workspace for orders</label>
            <% if (pi.knownWorkspaces.length) { %><select name="workspaceId"><option value="">Agency default</option><% for (const w of pi.knownWorkspaces) { %><option value="<%= w.id %>" <%= pi.workspaceId === w.id ? 'selected' : '' %>><%= w.name %></option><% } %></select>
            <% } else { %><input name="workspaceId" value="<%= pi.workspaceId || '' %>" placeholder="optional; the list appears after the first save"><% } %>
          </div>
        </div>
        <div class="grid3">
          <div class="field"><label>DNS / hosting platform</label><select name="h_platform"><% for (const p of ['Namecheap', 'Cloudflare', 'GoDaddy', 'Porkbun']) { %><option <%= pi.hosting.platform === p ? 'selected' : '' %>><%= p %></option><% } %></select></div>
          <div class="field"><label>Hosting username</label><input name="h_username" value="<%= pi.hosting.username || '' %>"></div>
          <div class="field"><label>Hosting password <%= pi.hosting.password ? '(set)' : '' %></label><input name="h_password" placeholder="<%= pi.hosting.password || '' %>" autocomplete="off"></div>
          <div class="field"><label>Namecheap backup codes <%= pi.hosting.namecheapBackupCodes ? '(set)' : '' %></label><input name="h_backupCodes" placeholder="required by them for Namecheap"></div>
          <div class="field"><label>GoDaddy account name</label><input name="h_goDaddyAccountName" value="<%= pi.hosting.goDaddyAccountName || '' %>"></div>
        </div>
        <h4 style="margin:0.4rem 0; font-size:0.85rem">Order defaults</h4>
        <div class="grid3">
          <div class="field"><label>Provider</label><select name="d_emailProvider"><option <%= pi.defaults.emailProvider === 'Google' ? 'selected' : '' %>>Google</option><option <%= pi.defaults.emailProvider === 'Microsoft' ? 'selected' : '' %>>Microsoft</option></select></div>
          <div class="field"><label>Inboxes per domain</label><input type="number" name="d_inboxesPerDomain" min="1" max="10" value="<%= pi.defaults.inboxesPerDomain %>"></div>
          <div class="field"><label>Default forwarding domain</label><input name="d_forwardedDomain" value="<%= pi.defaults.forwardedDomain || '' %>" placeholder="your website"></div>
          <div class="field"><label>Address patterns</label><input name="d_prefixVariants" value="<%= (pi.defaults.prefixVariants || []).join(', ') %>"></div>
          <div class="field"><label>Profile picture URL</label><input name="d_profilePictureLink" value="<%= pi.defaults.profilePictureLink || '' %>"></div>
          <div class="field"><label>Master inbox (forwarding)</label><input name="d_masterInboxEmail" value="<%= pi.defaults.masterInboxEmail || '' %>"></div>
          <div class="field"><label style="margin-top:1.2rem"><input type="checkbox" name="d_insured" value="1" <%= pi.defaults.insured ? 'checked' : '' %>> Insured by default</label></div>
        </div>
        <div class="row">
          <button type="submit">Save &amp; test</button>
          <% if (pi.configured) { %><button type="submit" formaction="/ui/integrations/premiuminboxes/test" class="secondary">Test token</button><button type="submit" name="delete" value="1" class="secondary" data-confirm="Disconnect Premium Inboxes from this workspace?">Disconnect</button><% } %>
        </div>
      </form>
    </div>
    <footer><button type="button" class="secondary" data-close>Close</button></footer>
  </div>
</dialog>

<script>
(function () {
  document.querySelectorAll('[data-open]').forEach((b) => b.addEventListener('click', () => { const d = document.getElementById(b.dataset.open); if (d) d.showModal(); }));
  document.querySelectorAll('dialog').forEach((d) => {
    d.querySelectorAll('[data-close]').forEach((c) => c.addEventListener('click', () => d.close()));
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
  document.querySelectorAll('[data-confirm]').forEach((el) => el.addEventListener('click', (e) => { if (!confirm(el.dataset.confirm)) { e.preventDefault(); e.stopImmediatePropagation(); } }));
  const panel = <%- JSON.stringify(panel || '') %>;
  if (panel) { const d = document.getElementById('dlg-' + panel); if (d) d.showModal(); }

  const form = document.getElementById('batch');
  if (!form) return;
  const PRICE_PER_INBOX = <%= pricePerInboxCents %> / 100;
  const CURRENCY = <%- JSON.stringify((candidates && candidates.find((c) => c.currency) || {}).currency || 'USD') %>;
  const picks = () => Array.from(form.querySelectorAll('.pick'));
  const first = document.getElementById('firstName'), last = document.getElementById('lastName');
  const clean = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]/g, '');
  function render(key, f, l) {
    switch (key) {
      case 'first': return f;
      case 'first.last': return f && l ? f + '.' + l : '';
      case 'first.l': return f && l ? f + '.' + l[0] : '';
      case 'f.last': return f && l ? f[0] + '.' + l : '';
      case 'firstlast': return f && l ? f + l : '';
      case 'flast': return f && l ? f[0] + l : '';
      case 'last': return l;
      default: return '';
    }
  }
  function previews() {
    const f = clean(first.value) || 'dave', l = clean(last.value) || 'spies';
    document.querySelectorAll('[data-pattern]').forEach((el) => { el.textContent = (render(el.dataset.pattern, f, l) || '—') + '@'; });
  }
  function cost() {
    const on = picks().filter((c) => c.checked);
    const per = Math.max(1, Number(document.getElementById('perDomain').value || 1));
    const body = document.getElementById('cost-body'), foot = document.getElementById('cost-foot');
    if (on.length === 0) { body.innerHTML = '<tr><td class="muted" colspan="4">Tick domains above to see the breakdown.</td></tr>'; foot.innerHTML = ''; document.getElementById('batch-summary').textContent = ''; return; }
    const byTld = new Map();
    let owned = 0;
    for (const c of on) {
      if (c.dataset.owned) { owned++; continue; }
      const k = '.' + (c.dataset.tld || c.value.split('.').slice(1).join('.'));
      const cur = byTld.get(k) || { n: 0, price: Number(c.dataset.price || 0) };
      cur.n++; byTld.set(k, cur);
    }
    let rows = '', domainsTotal = 0;
    for (const [tld, v] of byTld) { const amt = v.n * v.price; domainsTotal += amt; rows += '<tr><td>Domain registration ' + tld + ', 1 year</td><td class="num">' + v.n + '</td><td class="num">' + v.price.toFixed(2) + '</td><td class="num">' + amt.toFixed(2) + '</td></tr>'; }
    if (owned) rows += '<tr><td>Domains already owned</td><td class="num">' + owned + '</td><td class="num">0.00</td><td class="num">0.00</td></tr>';
    const inboxes = on.length * per, inboxTotal = inboxes * PRICE_PER_INBOX;
    rows += '<tr><td>Mailboxes, per 4 weeks</td><td class="num">' + inboxes + '</td><td class="num">' + PRICE_PER_INBOX.toFixed(2) + '</td><td class="num">' + inboxTotal.toFixed(2) + '</td></tr>';
    body.innerHTML = rows;
    foot.innerHTML = '<tr><td colspan="3">Now, at Namecheap</td><td class="num">' + domainsTotal.toFixed(2) + ' ' + CURRENCY + '</td></tr><tr><td colspan="3">Every 4 weeks, at Premium Inboxes</td><td class="num">' + inboxTotal.toFixed(2) + ' USD</td></tr>';
    document.getElementById('batch-summary').textContent = on.length + ' domain' + (on.length === 1 ? '' : 's') + ' · ' + inboxes + ' mailbox' + (inboxes === 1 ? '' : 'es');
    const bn = document.getElementById('balance-note');
    if (bn) { const avail = Number(bn.dataset.available); const v = document.getElementById('balance-verdict'); v.textContent = domainsTotal > avail ? 'This batch needs ' + (domainsTotal - avail).toFixed(2) + ' more than the balance.' : domainsTotal ? 'Enough for this batch.' : ''; bn.classList.toggle('bad', domainsTotal > avail); bn.classList.toggle('info', domainsTotal <= avail); }
    const btn = document.getElementById('batch-submit');
    btn.textContent = (on.length - owned ? 'Buy ' + (on.length - owned) + ' domain' + (on.length - owned === 1 ? '' : 's') + ' & order ' : 'Order ') + inboxes + ' mailbox' + (inboxes === 1 ? '' : 'es');
  }
  picks().forEach((c) => c.addEventListener('change', cost));
  document.getElementById('perDomain').addEventListener('input', cost);
  [first, last].forEach((el) => el.addEventListener('input', previews));
  const tickAll = document.getElementById('tick-all');
  if (tickAll) tickAll.addEventListener('click', () => { picks().forEach((c) => { if (!c.dataset.owned) c.checked = true; }); cost(); });
  // Picture: a chosen file travels as a data URL; a URL is used as is.
  const picFile = document.getElementById('picFile'), picUrl = document.getElementById('pictureUrl'), preview = document.getElementById('picPreview'), picData = document.getElementById('pictureData');
  picFile.addEventListener('change', () => {
    const f = picFile.files && picFile.files[0];
    if (!f) return;
    if (f.size > 4 * 1024 * 1024) { alert('Pick an image under 4 MB.'); picFile.value = ''; return; }
    const r = new FileReader();
    r.onload = () => { picData.value = String(r.result); preview.src = String(r.result); preview.hidden = false; picUrl.value = ''; };
    r.readAsDataURL(f);
  });
  picUrl.addEventListener('input', () => { if (picUrl.value) { picData.value = ''; preview.src = picUrl.value; preview.hidden = false; } });
  form.addEventListener('submit', (e) => {
    if (e.submitter && e.submitter.getAttribute('formaction')) return; // a check, not the order
    const on = picks().filter((c) => c.checked);
    if (on.length === 0) { e.preventDefault(); alert('Tick at least one domain.'); return; }
    if (!first.value.trim() || !last.value.trim()) { e.preventDefault(); alert('Fill in the first and last name for the mailboxes.'); return; }
    if (!form.querySelector('[name=forwardedDomain]').value.trim()) { e.preventDefault(); alert('Fill in the forwarding domain: the website the new domains redirect to.'); return; }
    if (!form.querySelector('[name=patterns]:checked')) { e.preventDefault(); alert('Tick at least one address pattern.'); return; }
    const buy = on.filter((c) => !c.dataset.owned).length;
    const per = Math.max(1, Number(document.getElementById('perDomain').value || 1));
    if (!confirm((buy ? 'Register ' + buy + ' domain(s) at Namecheap now and ' : '') + 'order ' + on.length * per + ' mailbox(es) at Premium Inboxes? Both are billed to your accounts there.')) e.preventDefault();
  });
  // ---- draft: autosaved in the browser, exportable as JSON -----------------
  const DRAFT = 'oem.batch.draft';
  const FIELDS = ['brand', 'custom', 'emailProvider', 'forwardedDomain', 'inboxesPerDomain', 'password', 'firstName', 'lastName', 'tags', 'pictureUrl', 'additionalInfo'];
  function state() {
    const s = { version: 1 };
    for (const k of FIELDS) { const el = form.querySelector('[name=' + k + ']'); if (el) s[k] = el.value; }
    s.tlds = Array.from(form.querySelectorAll('[name=tlds]:checked')).map((c) => c.value);
    s.patterns = Array.from(form.querySelectorAll('[name=patterns]:checked')).map((c) => c.value);
    s.insured = !!form.querySelector('[name=insured]:checked');
    s.domains = picks().filter((c) => c.checked).map((c) => c.value);
    return s;
  }
  function apply(s) {
    for (const k of FIELDS) { const el = form.querySelector('[name=' + k + ']'); if (el && s[k] !== undefined) el.value = s[k]; }
    if (Array.isArray(s.tlds)) form.querySelectorAll('[name=tlds]').forEach((c) => { c.checked = s.tlds.includes(c.value); });
    if (Array.isArray(s.patterns)) form.querySelectorAll('[name=patterns]').forEach((c) => { c.checked = s.patterns.includes(c.value); });
    const ins = form.querySelector('[name=insured]'); if (ins && s.insured !== undefined) ins.checked = !!s.insured;
    if (Array.isArray(s.domains)) {
      const have = new Set(picks().map((c) => c.value));
      picks().forEach((c) => { c.checked = s.domains.includes(c.value); });
      // Domains the page does not list yet go into the paste box, to be checked.
      const missing = s.domains.filter((d) => !have.has(d));
      if (missing.length) { const custom = form.querySelector('[name=custom]'); custom.value = [custom.value, missing.join(', ')].filter(Boolean).join(', '); }
    }
    if (s.pictureUrl) { preview.src = s.pictureUrl; preview.hidden = false; }
    previews(); cost();
  }
  const save = () => { try { localStorage.setItem(DRAFT, JSON.stringify(state())); } catch (e) {} };
  form.addEventListener('input', save);
  form.addEventListener('change', save);
  const serverHasState = <%- JSON.stringify(!!(wizard.brand || wizard.custom || wizard.firstName || (wizard.picked && wizard.picked.length))) %>;
  if (!serverHasState) {
    try { const d = JSON.parse(localStorage.getItem(DRAFT) || 'null'); if (d && d.version === 1) apply(d); } catch (e) {}
  } else save();
  document.getElementById('batch-export').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(state(), null, 2)], { type: 'application/json' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'batch-' + (state().brand || 'domains') + '.json'; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  document.getElementById('batch-import-btn').addEventListener('click', () => document.getElementById('batch-import').click());
  document.getElementById('batch-import').addEventListener('change', (e) => {
    const f = e.target.files && e.target.files[0]; if (!f) return;
    const r = new FileReader();
    r.onload = () => { try { apply(JSON.parse(String(r.result))); save(); } catch (err) { alert('That file is not a batch JSON.'); } };
    r.readAsText(f); e.target.value = '';
  });
  document.getElementById('batch-clear').addEventListener('click', () => {
    if (!confirm('Clear the batch and forget the autosaved draft?')) return;
    try { localStorage.removeItem(DRAFT); } catch (e) {}
    form.reset(); picks().forEach((c) => { c.checked = false; }); picData.value = ''; preview.hidden = true; previews(); cost();
  });
  // A placed order empties the draft (the page reloads with a notice and no wizard state).
  <% if (notice && /order .* placed/.test(notice)) { %>try { localStorage.removeItem(DRAFT); } catch (e) {}<% } %>
  const werr = document.getElementById('wizard-error'); if (werr) werr.scrollIntoView({ block: 'start' });
  previews(); cost();
})();
</script>
<%- include('_footer') %>
