<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>OutreachEmailMCP</title>
<style>
  :root { color-scheme: light dark; --fg:#1a1a2e; --bg:#fafafa; --card:#fff; --line:#e2e2ea; --accent:#3b5bdb; --muted:#6b7280; --ok:#12b76a; --warn:#f79009; --err:#f04438; }
  @media (prefers-color-scheme: dark) { :root { --fg:#e5e7eb; --bg:#101014; --card:#1a1a22; --line:#2c2c38; --muted:#9ca3af; } }
  * { box-sizing: border-box; }
  body { margin:0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background:var(--bg); color:var(--fg); }
  nav { display:flex; gap:1.2rem; align-items:center; padding:0.8rem 1.5rem; border-bottom:1px solid var(--line); background:var(--card); }
  nav .brand { font-weight:700; margin-right:1rem; }
  nav a { color:var(--fg); text-decoration:none; opacity:0.75; }
  nav a.active, nav a:hover { opacity:1; color:var(--accent); }
  nav form { margin-left:auto; }
  main { max-width:1000px; margin:1.5rem auto; padding:0 1.5rem; }
  h1 { font-size:1.35rem; } h2 { font-size:1.05rem; margin-top:2rem; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:1rem 1.2rem; margin:1rem 0; }
  table { width:100%; border-collapse:collapse; font-size:0.88rem; }
  th, td { text-align:left; padding:0.45rem 0.6rem; border-bottom:1px solid var(--line); vertical-align:top; }
  th { color:var(--muted); font-weight:600; font-size:0.78rem; text-transform:uppercase; letter-spacing:0.04em; }
  .badge { display:inline-block; padding:0.1rem 0.55rem; border-radius:99px; font-size:0.75rem; font-weight:600; }
  .badge.active, .badge.sent, .badge.delivered { background:color-mix(in srgb, var(--ok) 15%, transparent); color:var(--ok); }
  .badge.queued, .badge.sending, .badge.pending, .badge.delivering { background:color-mix(in srgb, var(--warn) 15%, transparent); color:var(--warn); }
  .badge.failed, .badge.auth_error, .badge.disabled { background:color-mix(in srgb, var(--err) 15%, transparent); color:var(--err); }
  button, .btn { background:var(--accent); border:none; color:#fff; padding:0.45rem 0.9rem; border-radius:7px; font-size:0.85rem; cursor:pointer; text-decoration:none; display:inline-block; }
  button.danger { background:var(--err); }
  button.secondary { background:transparent; color:var(--fg); border:1px solid var(--line); }
  input, select { padding:0.45rem 0.6rem; border:1px solid var(--line); border-radius:7px; background:var(--bg); color:var(--fg); font-size:0.88rem; }
  form.inline { display:inline; }
  .row { display:flex; gap:0.6rem; align-items:center; flex-wrap:wrap; }
  .muted { color:var(--muted); font-size:0.82rem; }
  .alert { border-radius:8px; padding:0.7rem 1rem; margin:1rem 0; font-size:0.88rem; }
  .alert.error { background:color-mix(in srgb, var(--err) 12%, transparent); color:var(--err); }
  .alert.success { background:color-mix(in srgb, var(--ok) 12%, transparent); color:var(--ok); }
  code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size:0.84em; }
  .secret { background:color-mix(in srgb, var(--accent) 8%, transparent); padding:0.6rem 0.8rem; border-radius:7px; word-break:break-all; }
  .reveal { filter: blur(4px); transition: filter 0.15s; } .reveal:hover { filter: none; }
  /* auth pages */
  .auth-wrap { min-height:86vh; display:flex; align-items:center; justify-content:center; padding:2rem 1rem; }
  .auth-card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:2.4rem 2.4rem 2rem; width:100%; max-width:400px; box-shadow:0 10px 40px rgba(0,0,0,0.08); }
  .auth-brand { text-align:center; font-weight:800; font-size:1.3rem; margin:0 0 0.25rem; }
  .auth-sub { text-align:center; color:var(--muted); font-size:0.88rem; margin:0 0 1.7rem; }
  .auth-card label { display:block; font-size:0.78rem; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:0.05em; margin:1rem 0 0.35rem; }
  .auth-card input { width:100%; padding:0.62rem 0.75rem; font-size:0.95rem; }
  .auth-card button[type=submit] { width:100%; margin-top:1.4rem; padding:0.68rem; font-size:0.95rem; }
  .auth-alt { text-align:center; margin-top:1.2rem; font-size:0.87rem; }
  .auth-alt a { color:var(--accent); text-decoration:none; }
  .divider { display:flex; align-items:center; gap:0.8rem; color:var(--muted); font-size:0.75rem; text-transform:uppercase; letter-spacing:0.06em; margin:1.4rem 0 1.1rem; }
  .divider::before, .divider::after { content:""; flex:1; height:1px; background:var(--line); }
  .btn-google { display:flex; align-items:center; justify-content:center; gap:0.7rem; width:100%; background:#fff; color:#3c4043; border:1px solid #dadce0; border-radius:8px; padding:0.62rem; font-size:0.92rem; font-weight:500; text-decoration:none; transition:background 0.12s, box-shadow 0.12s; }
  .btn-google:hover { background:#f8f9fa; box-shadow:0 1px 3px rgba(60,64,67,0.15); }
  @media (prefers-color-scheme: dark) {
    .btn-google { background:#131314; color:#e3e3e3; border-color:#3c3f43; }
    .btn-google:hover { background:#1b1c1e; }
  }
</style>
</head>
<body>
<% if (typeof page !== 'undefined' && page !== 'login') { %>
<nav>
  <span class="brand">📧 OutreachEmailMCP</span>
  <a href="/ui" class="<%= page === 'dashboard' ? 'active' : '' %>">Accounts</a>
  <a href="/ui/apikeys" class="<%= page === 'apikeys' ? 'active' : '' %>">API keys</a>
  <a href="/ui/webhooks" class="<%= page === 'webhooks' ? 'active' : '' %>">Webhooks</a>
  <a href="/ui/sendlog" class="<%= page === 'sendlog' ? 'active' : '' %>">Send log</a>
  <a href="/ui/activity" class="<%= page === 'activity' ? 'active' : '' %>">Activity</a>
  <% if (typeof saasMode !== 'undefined' && saasMode) { %>
  <a href="/ui/billing" class="<%= page === 'billing' ? 'active' : '' %>">Billing</a>
  <% } %>
  <form method="post" action="/ui/logout">
    <% if (typeof orgName !== 'undefined' && orgName && typeof saasMode !== 'undefined' && saasMode) { %><span class="muted" style="margin-right:0.8rem"><%= orgName %></span><% } %>
    <button class="secondary" type="submit">Log out</button>
  </form>
</nav>
<% } %>
<main>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>
<% if (typeof notice !== 'undefined' && notice) { %><div class="alert success"><%= notice %></div><% } %>
