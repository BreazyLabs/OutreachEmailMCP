<%- include('_header', { page: page }) %>
<div class="pagehead">
  <div>
    <h1>New workspace</h1>
    <p class="sub">A workspace owns its own mailboxes, API keys, webhooks and send log. Nothing is shared between them — creating one here is how a new customer gets an isolated place to connect inboxes.</p>
  </div>
</div>
<form method="post" action="/ui/workspace/new" class="card" style="max-width:560px">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="field">
    <label for="ws-name">Workspace name</label>
    <input id="ws-name" name="name" placeholder="Acme Corp" autofocus>
  </div>
  <div class="row">
    <button type="submit">Create workspace</button>
    <a class="btn secondary" href="/ui">Cancel</a>
  </div>
  <p class="muted" style="margin:1rem 0 0">You are switched into the new workspace immediately. Use the switcher in the sidebar to move between workspaces.</p>
</form>
<%- include('_footer') %>
