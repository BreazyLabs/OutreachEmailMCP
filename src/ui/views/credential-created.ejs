<%- include('_header') %>
<h1>SMTP credential created</h1>
<div class="alert success">Save the password now — it is shown only once.</div>
<div class="card">
  <table>
    <tr><th>SMTP server</th><td><code><%= smtpHost %>:<%= smtpPort %></code> (STARTTLS)</td></tr>
    <tr><th>IMAP server</th><td><code><%= smtpHost %>:<%= imapPort %></code> (STARTTLS, same credentials)</td></tr>
    <tr><th>Username</th><td><div class="secret mono"><%= username %></div></td></tr>
    <tr><th>Password</th><td><div class="secret mono"><%= password %></div></td></tr>
    <tr><th>From address</th><td><code><%= account.email %></code></td></tr>
  </table>
</div>
<a class="btn" href="/ui/accounts/<%= account.id %>">Back to account</a>
<%- include('_footer') %>
