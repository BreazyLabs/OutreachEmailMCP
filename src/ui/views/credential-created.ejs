<%- include('_header') %>
<div class="crumb"><a href="/ui">Mailboxes</a> <span>/</span> <a href="/ui/accounts/<%= account.id %>"><%= account.email %></a></div>
<div class="pagehead">
  <div>
    <h1>SMTP credential created</h1>
    <p class="sub">Save the password now — it is shown only once.</p>
  </div>
  <div class="actions"><a class="btn secondary" href="/ui/accounts/<%= account.id %>">Back to the mailbox</a></div>
</div>
<div class="card flush" style="max-width:760px">
  <table>
    <tbody>
    <tr><th style="width:150px">SMTP server</th><td><code><%= smtpHost %>:<%= smtpPort %></code> (<%= implicitTls ? 'SSL/TLS' : 'STARTTLS' %>)</td></tr>
    <tr><th>IMAP server</th><td><code><%= smtpHost %>:<%= imapPort %></code> (<%= implicitTls ? 'SSL/TLS' : 'STARTTLS' %>, same credentials)</td></tr>
    <tr><th>Username</th><td><div class="secret mono"><%= username %></div></td></tr>
    <tr><th>Password</th><td><div class="secret mono"><%= password %></div></td></tr>
    <tr><th>From address</th><td><code><%= account.email %></code></td></tr>
    </tbody>
  </table>
</div>
<%- include('_footer') %>
