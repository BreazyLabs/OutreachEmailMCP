<%- include('_header') %>
<div class="pagehead">
  <div>
    <h1>Activity</h1>
    <p class="sub">Every transaction — logins, submissions, delivery attempts, warmup moves, flag syncs, polls, webhooks, token refreshes — with pass/fail. Kept <%= retentionDays %> days.</p>
  </div>
</div>
<div class="kpis" style="grid-template-columns:repeat(auto-fit, minmax(200px, 260px))">
  <div class="kpi <%= failedLast24h ? 'bad' : 'good' %>"><div class="n"><%= failedLast24h %></div><div class="l">failures, last 24h</div></div>
</div>
<div class="card flush">
  <form method="get" action="/ui/activity" class="card-head">
    <div class="row">
      <select name="status" aria-label="Status">
        <option value="">All statuses</option>
        <option value="ok" <%= filters.status === 'ok' ? 'selected' : '' %>>ok</option>
        <option value="failed" <%= filters.status === 'failed' ? 'selected' : '' %>>failed</option>
      </select>
      <select name="category" aria-label="Category">
        <option value="">All categories</option>
        <% for (const c of ['smtp','imap','api','mcp','delivery','poll','webhook','oauth','warmup','domains','health']) { %>
        <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
        <% } %>
      </select>
      <button type="submit" class="secondary">Filter</button>
      <% if (filters.status || filters.category) { %><a href="/ui/activity" class="muted">Clear</a><% } %>
    </div>
    <span class="muted"><%= rows.length %> shown</span>
  </form>
  <% if (rows.length === 0) { %><p class="empty">No activity recorded<%= filters.status || filters.category ? ' for this filter' : ' yet' %>.</p><% } else { %>
  <div class="scroll-x">
  <table>
    <thead><tr><th>When</th><th>Mailbox</th><th>Category</th><th>Action</th><th>Status</th><th>Detail</th></tr></thead>
    <tbody>
    <% for (const r of rows) { %>
    <tr>
      <td class="muted" style="white-space:nowrap"><%= new Date(r.createdAt).toLocaleString() %></td>
      <td><%= r.accountEmail || '—' %></td>
      <td><span class="badge"><%= r.category %></span></td>
      <td><%= r.action %></td>
      <td><span class="badge <%= r.status === 'ok' ? 'sent' : 'failed' %>"><%= r.status %></span></td>
      <td class="muted" style="max-width:480px; word-break:break-word"><%= r.detail || '' %><% if (r.error) { %><br><span style="color:var(--err)"><%= r.error %></span><% } %></td>
    </tr>
    <% } %>
    </tbody>
  </table>
  </div>
  <% } %>
</div>
<%- include('_footer') %>
