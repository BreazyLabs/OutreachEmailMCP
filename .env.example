# --- Core ---
# 32-byte base64 master key for encrypting OAuth tokens at rest.
# Generate with: openssl rand -base64 32
MASTER_KEY=

# Public base URL of this instance (used for OAuth redirect URIs and links).
BASE_URL=http://localhost:3000

# Admin password for the web UI.
ADMIN_PASSWORD=change-me

# --- HTTP ---
HTTP_PORT=3000
HTTP_BIND=127.0.0.1

# --- SMTP listener ---
SMTP_PORT=2525
# Implicit-TLS (SSL-on-connect) listeners, the convention most sequencers
# assume for mail ports — these are what the CSV export advertises. Set to 0
# to disable either one.
SMTPS_PORT=465
SMTP_BIND=127.0.0.1
# Max message size in bytes (default 25 MB)
SMTP_MAX_SIZE=26214400
# Allow AUTH without STARTTLS (only enable for trusted localhost-only setups)
SMTP_ALLOW_INSECURE_AUTH=false
# Optional: paths to TLS cert/key for STARTTLS. If unset, a self-signed pair
# is generated into data/certs/ on first boot.
SMTP_TLS_CERT=
SMTP_TLS_KEY=
# Hostname advertised for SMTP/IMAP in CSV exports and the UI. Defaults to
# BASE_URL's hostname. Set this when BASE_URL is behind a proxying CDN
# (Cloudflare orange-cloud) that won't forward raw TCP — point an unproxied
# DNS record (e.g. smtp.yourdomain.com) at the server and put it here.
MAIL_HOST=

# --- Google OAuth (Web application client) ---
# Redirect URIs to register:
#   {BASE_URL}/auth/google/callback        (mailbox connect)
#   {BASE_URL}/auth/sso/google/callback    (Sign in with Google — SaaS mode only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft OAuth (Azure app registration, "Web" platform) ---
# Redirect URI to register: {BASE_URL}/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant: "common" allows both org + personal accounts
MICROSOFT_TENANT=common

# --- IMAP listener (read replies through the proxy; same credentials as SMTP) ---
IMAP_PORT=1143
IMAPS_PORT=993
IMAP_BIND=127.0.0.1
# Allow LOGIN without STARTTLS (only for trusted localhost-only setups)
IMAP_ALLOW_INSECURE_AUTH=false
# Recent INBOX messages indexed per account on first IMAP use
IMAP_BACKFILL_COUNT=50

# --- Spool retention ---
# Raw .eml files of successfully sent mail are kept this many hours for
# debugging, then deleted (the provider's Sent folder keeps the canonical copy).
# Failed/queued mail is never cleaned up. Set 0 to delete on the next sweep.
SENT_RAW_RETENTION_HOURS=24

# --- Inbound polling / webhooks ---
# Poll interval for new mail, in seconds
POLL_INTERVAL=60
# Allow webhook targets on private/loopback addresses
WEBHOOKS_ALLOW_PRIVATE=false

# --- SaaS mode (leave off for self-hosting) ---
# Enables multi-tenant workspaces: public signup, per-org quotas, billing.
# Self-hosted default (false): single workspace, ADMIN_PASSWORD login, no limits.
SAAS_MODE=false
# Stripe (optional; all three required to enable billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# Plan limits (only enforced in SaaS mode)
PLAN_FREE_MAX_ACCOUNTS=2
PLAN_FREE_DAILY_SENDS=100
PLAN_PRO_MAX_ACCOUNTS=50
PLAN_PRO_DAILY_SENDS=5000

# --- Observability ---
# Default lifetime of provider-specific connect links, in hours (0 = never
# expires). The dashboard's onboarding link never expires and is revoked from
# the UI instead — this only affects /auth/<provider>/start?token=… links.
CONNECT_LINK_TTL_HOURS=168

# --- Daily health check ---
# Sweeps mailbox access, tokens, the send queue, inbound polling, webhooks,
# quotas, TLS expiry and disk once a day, and emails anything wrong. Sent from
# the workspace's own healthiest mailbox through the proxy.
# Hour of day (UTC) to run it:
HEALTH_REPORT_HOUR=7
# Who gets the report; comma-separated. Leave empty to mail each workspace's
# owners instead. Set it to receive infrastructure findings (disk, TLS) too.
HEALTH_REPORT_TO=
# Send a report even when nothing is wrong (proves the checker itself is alive)
HEALTH_REPORT_ALWAYS=false

# Days to keep the transaction/activity log (every auth, submit, delivery,
# warmup move, flag sync, poll, webhook — pass/fail; /ui/activity)
ACTIVITY_RETENTION_DAYS=30

# --- Misc ---
LOG_LEVEL=info
DATA_DIR=./data
